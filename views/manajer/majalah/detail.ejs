<%- include('../../partials/header/__header-dashboard.ejs', { title: 'Detail Majalah Dihapus' }) %>
<%- include('../../partials/nav-side/__nav-side-manajer.ejs') %>
<%- include('../../partials/messages/__messages-dashboard.ejs') %>

<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-3 mb-3 mb-md-0">
                                <div class="d-flex flex-column align-items-center">
                                    <div class="d-md-none mb-3 w-100">
                                        <div class="btn-actions-mobile d-flex gap-2 justify-content-center">
                                            <a href="/manajer/majalah" class="btn btn-light btn-sm">Kembali</a>
                                            <button type="button" class="btn btn-outline-success btn-sm" data-toggle="modal" data-target="#modalPulihkan">
                                                Tampilkan
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-sm" data-toggle="modal" data-target="#modalConfirmDelete">
                                                Hapus
                                            </button>
                                        </div>
                                    </div>
                                    <img
                                        class="img-click-preview"
                                        src="<%= majalah?.foto_cover ? '/images/majalah/' + majalah.foto_cover : '/images/no-image.png' %>"
                                        data-src="<%= majalah?.foto_cover ? '/images/majalah/' + majalah.foto_cover : '/images/no-image.png' %>"
                                        alt="Cover Majalah"
                                        style="width:100%; max-width:220px; border-radius:12px; object-fit:cover; cursor:zoom-in;"
                                    >
                                </div>
                            </div>
                            <div class="col-md-9">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h4 class="mb-0">
                                        <%= majalah?.judul || '-' %>
                                    </h4>
                                    <div class="btn-actions d-none d-md-flex gap-2">
                                        <a href="/manajer/majalah" class="btn btn-light btn-sm">Kembali</a>
                                        <button type="button" class="btn btn-outline-success btn-sm" data-toggle="modal" data-target="#modalPulihkan">
                                            Tampilkan
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-toggle="modal" data-target="#modalConfirmDelete">
                                            Hapus
                                        </button>
                                    </div>
                                </div>

                                <div class="detail-info">

                                    <div class="info-item">
                                        <span class="info-label">Edisi: <%= majalah?.edisi || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Nomor Klasifikasi: <%= majalah?.no_klasifikasi || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Kategori: <%= majalah?.nama_kategori || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Bahasa: <%= majalah?.nama_bahasa || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Tahun Terbit: <%= majalah?.tahun_terbit || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Penerbit: <%= majalah?.penerbit || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Tempat Terbit: <%= majalah?.tempat_terbit || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Sinopsis:</span>
                                        <div
                                            style="
                                                margin-top:4px;
                                                display:-webkit-box;
                                                line-clamp:5;
                                                -webkit-box-orient:vertical;
                                                overflow:hidden;
                                                line-height:1.5;
                                            "
                                        >
                                            <%= majalah?.sinopsis || '-' %>
                                        </div>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Ketersediaan: <%= majalah?.ketersediaan || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Kode Rak: <%= majalah?.kode_rak || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Kode Ruangan: <%= majalah?.kode_ruangan || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Kode Lantai: <%= majalah?.kode_lantai || '-' %></span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">
                                            Dihapus Pada:
                                            <%= majalah?.dihapus_pada
                                                ? new Date(majalah.dihapus_pada).toLocaleString('id-ID')
                                                : '-' %>
                                        </span>
                                    </div>

                                    <div class="info-item">
                                        <span class="info-label">Dihapus Oleh: <%= majalah?.dihapus_oleh || '-' %></span>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-below-navbar" id="modalPulihkan" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tampilkan Majalah</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Ubah status data majalah menjadi "Tampil"?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">Batal</button>
                <form action="/manajer/majalah/edit/<%= majalah && majalah.id %>" method="POST" data-loading>
                    <input type="hidden" name="status_data" value="Tampil">
                    <button type="submit" class="btn btn-success">Tampilkan</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-below-navbar" id="modalConfirmDelete" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Konfirmasi Hapus</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Apakah Anda yakin ingin menghapus majalah "<%= (majalah && majalah.judul) ? majalah.judul : 'ini' %>" secara permanen?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">Batal</button>
                <form action="/manajer/majalah/delete/<%= majalah && majalah.id %>" method="POST" data-loading>
                    <button type="submit" class="btn btn-danger">Hapus</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade modal-below-navbar modal-top" id="globalImagePreviewModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Pratinjau Gambar</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-0">
                <img id="globalImagePreviewEl" src="" alt="preview" style="width:100%;height:auto;display:block;">
            </div>
        </div>
    </div>
</div>

<%- include('../../partials/script/__script-dashboard.ejs') %>